{
  "name": "ui",
  "sourceRoot": "libs/shared/ui/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui", "runtime:react"],
  "targets": {
    "lint": {
      "command": "eslint libs/shared/ui"
    },
    "test-storybook": {
      "command": "playwright test --config libs/shared/ui/playwright.config.ts",
      "dependsOn": ["build-storybook"],
      "cache": false
    },
    "build-storybook": {
      "outputs": ["{workspaceRoot}/dist/storybook/ui"],
      "options": {
        "output-dir": "../../../dist/storybook/ui"
      }
    },
    "static-storybook": {
      "options": {
        "staticFilePath": "dist/storybook/ui"
      }
    }
  }
}
