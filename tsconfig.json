{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "libs/**/*.ts",
    "libs/**/*.tsx",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next", "dist"]
}
