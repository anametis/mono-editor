{
  "name": "kara",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@nestjs/testing": "11",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/web": "23.2.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@swc/helpers": "~0.5.18",
    "@types/express": "^5.0.6",
    "@types/jest": "29",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "4",
    "esbuild": "^0.28.2",
    "eslint": "9",
    "jest": "29",
    "nx": "23.2.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "smtp-server": "^3.19.13",
    "storybook": "^10.5.0",
    "ts-jest": "^29.4.13",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "6",
    "vite-tsconfig-paths": "5",
    "vitest": "3"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-express": "11",
    "@nestjs/swagger": "11",
    "@nestjs/throttler": "^6.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "better-auth": "1.7.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "5",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "openapi-fetch": "^0.17.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "19",
    "react-dom": "19",
    "react-hook-form": "^7.88.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "type": "module",
  "prisma": {
    "schema": "libs/platform/database/schema.prisma"
  },
  "scripts": {
    "dev:api": "pnpm build:api && node --env-file=.env dist/apps/api/main.mjs",
    "dev:worker": "pnpm build:worker && node --env-file=.env dist/apps/worker/main.mjs",
    "dev:admin": "vite --config apps/admin/vite.config.ts",
    "dev:web": "node tools/next.mjs dev",
    "build:api": "node tools/build-server.mjs api",
    "build:worker": "node tools/build-server.mjs worker",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:web": "node tools/next.mjs build",
    "build:offline": "pnpm build:api && pnpm build:worker && pnpm build:admin && pnpm build:web",
    "build": "pnpm contracts && pnpm build:offline",
    "contracts": "node tools/compile.mjs tools/openapi/generate.ts dist/tools/openapi.mjs && node --env-file=.env dist/tools/openapi.mjs && openapi-typescript docs/architecture/openapi.json -o libs/shared/api-client/src/schema.d.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "lint": "node tools/check-boundaries.mjs && NX_DAEMON=false nx graph --file=.local/graph.json && eslint apps libs tools tests && node tests/architecture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:integration": "node tools/compile.mjs tests/integration.ts dist/tests/integration.mjs && node --env-file=.env dist/tests/integration.mjs",
    "test:e2e": "playwright test",
    "bootstrap:staff": "node tools/compile.mjs tools/bootstrap-staff.ts dist/tools/bootstrap-staff.mjs && node --env-file=.env dist/tools/bootstrap-staff.mjs",
    "test:cache": "node tests/cache.mjs"
  }
}
